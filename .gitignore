# 개인정보 / 데이터 (절대 업로드 금지)
data/

# Python 캐시
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# 가상환경
.venv/
venv/
env/

# Streamlit 설정 (시크릿 포함 가능)
.streamlit/secrets.toml

# 배포 패키지 ZIP
*.zip

# Claude 작업 폴더
.claude/

# 임시/디버그 파일
_diag*.py
_test*.py
data/debug_page.html

# Windows
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/

# 로컬판 빌드 산출물(대용량)
local_build/_build/
.costcobiz_license.json
# 루트의 임시 스크립트(_patch_cart.py, _sp.py 등) 제외
_*.py
# 단, pages_lib의 '_' 접두사 파일은 화면 공유조각이라 배포에 반드시 들어가야 한다.
#   (이 예외가 없으면 새 조각이 커밋에서 조용히 빠져 서버가 ImportError로 죽는다)
!pages_lib/_*.py
